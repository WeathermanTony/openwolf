{
  "awaySummaryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/session-start.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/pre-read.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/pre-write.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/post-read.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/post-write.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_PROJECT_DIR+'/.wolf/hooks/stop.js';import('node:fs').then(fs=>{if(fs.existsSync(p))return import('node:url').then(({pathToFileURL})=>import(pathToFileURL(p).href))}).catch(e=>console.error('WolfPack hook load failed:',e.message))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}