{
  "name": "customopenwolf",
  "version": "1.2.0-custom.3",
  "description": "Wolfpack: Claude Code workflow harness built on the OpenWolf runtime namespace",
  "type": "module",
  "bin": {
    "openwolf": "./dist/bin/openwolf.js",
    "wolfpack": "./dist/bin/openwolf.js"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\"",
    "build": "tsc && npm run build:dashboard && npm run postbuild:chmod",
    "build:dashboard": "cd src/dashboard/app && npx vite build --outDir ../../../dist/dashboard",
    "postbuild:chmod": "node -e \"const fs=require('fs');const p='dist/bin/openwolf.js';if(fs.existsSync(p))fs.chmodSync(p,0o755)\"",
    "dev": "tsc --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "npm run build",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "node scripts/verify-install.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "express": "^5.0.0",
    "node-cron": "^3.0.3",
    "open": "^10.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.39.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Tony Cirigliano",
  "keywords": [
    "claude",
    "ai",
    "context",
    "token",
    "openwolf",
    "claude-code",
    "developer-tools"
  ],
  "files": [
    "dist/",
    "src/templates/",
    "LICENSE",
    "README.md"
  ]
}
